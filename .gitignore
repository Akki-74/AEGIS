# =============================================================================
# AEGIS .gitignore — Relevant Project Artifacts Only
# =============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
env/

# Testing, Coverage & Linters (Pytest, Coverage, Ruff, Mypy)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Editor & OS Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Environment Configuration & Secrets
.env
.env.*
!.env.example
config.yaml
!config.yaml.example

# Raw Binary Captures (Keep large packet dumps out, preserve test fixtures)
*.pcap
*.pcapng
*.evtx
!tests/fixtures/**

# Generated Incident Reports & Graph Visualizations
reports/*
!reports/.gitkeep
attack_graph.html
demo_attack_graph.html
attack_graph.json
incidents.json
*.ndjson

# Runtime Logs (Keep directory tracked, ignore transient logs)
logs/*
!logs/.gitkeep
*.log
*.jsonl
!docs/session_log.md

# Scratch & Temporary Directories
tmp/
temp/
scratch/
*.tmp
